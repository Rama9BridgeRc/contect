<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - ศูนย์นันทนาการสะพานพระราม 9</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* นำเข้าฟอนต์เสาชิงช้า (Sao Chingcha) */
        @font-face {
            font-family: 'Sao Chingcha';
            src: url('https://cdn.jsdelivr.net/gh/usamanyakoh/Project-Work@main/SaoChingcha-Regular.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        body {
            font-family: 'Sao Chingcha', 'Kanit', sans-serif;
            background: linear-gradient(135deg, #FFF0F5 0%, #FFE4E1 50%, #FFD1DC 100%);
            background-attachment: fixed;
        }
        
        /* เอฟเฟกต์ Glassmorphism สไตล์พรีเมียม */
        .link-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 8px 32px rgba(255, 182, 193, 0.2);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        
        .link-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(255, 105, 180, 0.25);
            background: rgba(255, 255, 255, 0.98);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center py-10 px-4">

    <!-- ส่วนหัวและโลโก้ -->
    <div class="text-center mb-8">
        <div class="relative w-32 h-32 mx-auto mb-5">
            <div class="absolute inset-0 bg-white/40 rounded-full shadow-lg transform rotate-6 scale-105"></div>
            <img src="https://raw.githubusercontent.com/usamanyakoh/Project-Work/main/BKKlogo.png" alt="Logo" class="relative w-32 h-32 mx-auto rounded-full object-cover shadow-md bg-white p-2 border-2 border-white/80">
        </div>
        <h1 class="text-[22px] font-bold text-gray-800 drop-shadow-sm tracking-wide">ศูนย์นันทนาการสะพานพระราม 9</h1>
    </div>

    <!-- คอนเทนเนอร์ใส่ปุ่ม -->
    <div id="links-container" class="w-full max-w-md flex flex-col gap-4">
        <div id="loading" class="text-center text-gray-500 py-4">
            <svg class="animate-spin h-8 w-8 text-pink-500 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="mt-2 font-medium">กำลังโหลดข้อมูล...</p>
        </div>
    </div>

    <script>
        // =========================================================================
        // สำคัญ: นำ URL ที่ได้จากการ Deploy Google Apps Script (Web App) มาวางที่นี่
        // =========================================================================
        const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzr21pJ2lhOzjK3qh6pD4tO8LgpE3AmE-Xkkvd_-l4tOpuLCahiNrAhmNV4Wu-TYLiHsQ/exec'; 

        const timeoutCheck = setTimeout(() => {
            const loader = document.getElementById('loading');
            if (loader) {
                loader.innerHTML = `
                    <div class="bg-white/80 p-4 rounded-xl shadow border border-red-200 text-left">
                        <p class="text-red-500 font-bold mb-2">⚠️ โหลดข้อมูลนานผิดปกติ</p>
                        <p class="text-sm text-gray-700">ไม่สามารถเชื่อมต่อกับฐานข้อมูลได้ กรุณาตรวจสอบลิงก์ Web App (WEB_APP_URL) ในโค้ด หรือการเชื่อมต่ออินเทอร์เน็ต</p>
                    </div>
                `;
            }
        }, 15000);

        function displayLinks(response) {
            clearTimeout(timeoutCheck);
            const container = document.getElementById('links-container');
            container.innerHTML = ''; 

            try {
                if (response.error) {
                    container.innerHTML = `<p class="text-red-500 text-center bg-white/60 p-4 rounded-xl font-semibold">${response.error}</p>`;
                    return;
                }

                const data = response.data || [];
                
                if (data.length === 0) {
                    container.innerHTML = `<p class="text-gray-500 text-center bg-white/60 p-4 rounded-xl font-semibold">ยังไม่มีข้อมูลในระบบ</p>`;
                    return;
                }

                data.forEach(item => {
                    if (!item.Platform || !item.URL) return;

                    const platform = String(item.Platform).toLowerCase().trim();
                    let urlIcon = 'https://cdn-icons-png.flaticon.com/512/2088/2088192.png';
                    let platformColor = '#d1d5db'; 

                    if (platform === 'x' || platform === 'twitter') {
                        urlIcon = 'https://upload.wikimedia.org/wikipedia/commons/c/ce/X_logo_2023.svg';
                        platformColor = '#000000';
                    } else if (platform.includes('facebook') || platform === 'fb') {
                        urlIcon = 'https://upload.wikimedia.org/wikipedia/commons/b/b8/2021_Facebook_icon.svg';
                        platformColor = '#1877F2';
                    } else if (platform.includes('line')) {
                        urlIcon = 'https://upload.wikimedia.org/wikipedia/commons/4/41/LINE_logo.svg';
                        platformColor = '#00B900';
                    } else if (platform.includes('instagram') || platform.includes('ig')) {
                        urlIcon = 'https://upload.wikimedia.org/wikipedia/commons/e/e7/Instagram_logo_2016.svg';
                        platformColor = '#E1306C';
                    } else if (platform.includes('threads')) {
                        urlIcon = 'https://cdn-icons-png.flaticon.com/512/11104/11104255.png'; 
                        platformColor = '#000000'; 
                    } else if (platform.includes('tiktok')) {
                        urlIcon = 'https://cdn-icons-png.flaticon.com/512/3046/3046121.png'; 
                        platformColor = '#000000'; 
                    } else if (platform.includes('youtube') || platform === 'yt') {
                        urlIcon = 'https://upload.wikimedia.org/wikipedia/commons/0/09/YouTube_full-color_icon_%282017%29.svg';
                        platformColor = '#FF0000'; 
                    } else if (platform.includes('website') || platform.includes('เว็บ')) {
                        urlIcon = 'https://cdn-icons-png.flaticon.com/512/1006/1006771.png';
                        platformColor = '#2563EB'; 
                    } else if (platform.includes('tel') || platform.includes('tell') || platform.includes('phone') || platform.includes('โทร')) {
                        urlIcon = 'https://cdn-icons-png.flaticon.com/512/5585/5585856.png';
                        platformColor = '#34C759';
                    } else if (platform.includes('map') || platform.includes('location') || platform.includes('แผนที่')) {
                        urlIcon = 'https://cdn-icons-png.flaticon.com/512/854/854878.png';
                        platformColor = '#EA4335';
                    }

                    const a = document.createElement('a');
                    a.href = item.URL;
                    a.target = '_blank';
                    a.rel = 'noopener noreferrer';
                    a.className = 'link-card group block rounded-[2rem] p-4 flex items-center gap-4 text-left overflow-hidden relative w-full';

                    a.innerHTML = `
                        <div class="absolute left-0 top-0 bottom-0 w-2 opacity-90 transition-all duration-300 group-hover:w-3" style="background-color: ${platformColor};"></div>
                        <div class="w-14 h-14 flex-shrink-0 flex items-center justify-center bg-white rounded-[1.25rem] shadow-[0_2px_10px_rgba(0,0,0,0.05)] ml-2">
                            <img src="${urlIcon}" alt="${item.Platform}" class="w-8 h-8 object-contain group-hover:scale-110 transition-transform duration-300">
                        </div>
                        <div class="flex-1 min-w-0 py-1">
                            <h2 class="font-semibold text-gray-800 text-[18px] truncate leading-tight">${item.Name || item.Platform}</h2>
                            ${item.Subtitle ? `<p class="text-gray-500 text-[14px] truncate mt-0.5">${item.Subtitle}</p>` : ''}
                        </div>
                        <div class="text-gray-300 group-hover:text-pink-500 pr-2 transition-colors duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    `;
                    container.appendChild(a);
                });
            } catch (err) {
                container.innerHTML = `<p class="text-red-500 text-center bg-white/60 p-4 rounded-xl mt-4">พบปัญหา: ${err.message}</p>`;
            }
        }

        // เริ่มดึงข้อมูลเมื่อหน้าเว็บโหลดเสร็จ
        document.addEventListener('DOMContentLoaded', () => {
            // ตรวจสอบว่าใส่ URL หรือยัง
            if(WEB_APP_URL === 'วาง_URL_ของ_GOOGLE_APPS_SCRIPT_ที่นี่') {
                 displayLinks({ error: "โปรดใส่ URL ของ Web App ในตัวแปร WEB_APP_URL ในซอร์สโค้ด (บรรทัดที่ 67) ก่อนใช้งาน" });
                 return;
            }

            // ใช้ fetch ดึงข้อมูลจาก API แทนการใช้ google.script.run
            fetch(WEB_APP_URL)
                .then(response => response.json())
                .then(data => displayLinks(data))
                .catch(error => {
                    displayLinks({ error: "ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้: " + error.message });
                });
        });
    </script>
</body>
</html>
